 {
  "doctype": "Custom Field",
  "name": "Company-custom_barakat_salary_expense_account",
  "dt": "Company",
  "fieldname": "custom_barakat_salary_expense_account",
  "label": "Salary Expense Account (Barakat)",
  "fieldtype": "Link",
  "options": "Account",
  "insert_after": "default_payroll_payable_account",
  "description": "The expense account staff wages are charged to. ERPNext keeps this per-company inside the shared Salary Component's accounts table, which no Barakat screen exposes - so it was never set and salary slips posted nothing at all. Holding it on the Company lets the setup walkthrough ask once and lets the accrual refuse rather than guess. Any Expense account qualifies."
 },
 {
  "doctype": "Custom Field",
  "name": "Company-custom_barakat_opening_account",
  "dt": "Company",
  "fieldname": "custom_barakat_opening_account",
  "label": "Opening Stock Account (Barakat)",
  "fieldtype": "Link",
  "options": "Account",
  "insert_after": "stock_adjustment_account",
  "description": "Where the value of stock the shop already owned is recorded when it starts using the system. ERPNext refuses a Profit-and-Loss account for an opening entry and only exposes the choice per-document as the Stock Reconciliation's Difference Account; holding it on the Company lets the setup walkthrough ask for it once and stops the proxy guessing. Any Balance Sheet account qualifies - the standard chart ships Temporary Opening."
 },
 {
  "doctype": "Custom Field",
  "name": "Attendance-custom_branch",
  "dt": "Attendance",
  "fieldname": "custom_branch",
  "label": "Branch (Barakat)",
  "fieldtype": "Link",
  "options": "Branch",
  "description": "Which branch the employee worked at on this day. Barakat staff can be assigned to several branches, and native Attendance only carries company + department, so the branch has nowhere else to live. Still one record per employee per day — ERPNext forbids more.",
  "insert_after": "department",
  "in_list_view": 0,
  "in_standard_filter": 1
 },
 {
  "doctype": "Custom Field",
  "name": "Company-custom_barakat_coa_language",
