  "fieldtype": "Select",
  "options": "\nar\nhe\nen",
  "insert_after": "chart_of_accounts",
  "description": "Set once, at creation, by the Barakat admin panel. Decides the language the chart of accounts is BUILT in; changing it later does nothing.",
  "read_only": 1,
  "hidden": 0
 }
